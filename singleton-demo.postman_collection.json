                  "pm.test('same instance as first call', () => {",
                  "  const current = body.instanceId + ':' + body.instanceHashCode;",
                  "  pm.expect(current).to.eql(pm.collectionVariables.get('doubleCheckedLockingInstanceId'));",
                  "});"
                ]
