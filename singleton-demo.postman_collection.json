{
  "info": {
    "name": "Design Patterns Demo",
    "description": "Verifies the design pattern demos in the design-patterns Spring Boot app: Singleton (same instance across repeated calls) and Factory Method (correct concrete sender resolved per channel, invalid channel rejected).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "doubleCheckedLockingInstanceId",
      "value": ""
    },
    {
      "key": "enumInstanceId",
      "value": ""
    },
    {
      "key": "billPughInstanceId",
      "value": ""
    },
    {
      "key": "springInstanceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Singleton Verification",
      "item": [
        {
          "name": "Double-Checked Locking - Call 1",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/singleton/double-checked-locking"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('doubleCheckedLockingInstanceId', body.instanceId + ':' + body.instanceHashCode);",
                  "pm.test('instanceId and hashCode are present', () => {",
                  "  pm.expect(body.instanceId).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.instanceHashCode).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Double-Checked Locking - Call 2",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/singleton/double-checked-locking"
